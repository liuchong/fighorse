{
  "name": "fighorse",
  "version": "0.1.0",
  "description": "Figma data Swiss Army knife, shaped for AI consumption",
  "packageManager": "bun@1.2.8",
  "engines": {
    "bun": ">=1.2.0"
  },
  "bin": {
    "fighorse": "dist/fighorse"
  },
  "scripts": {
    "dev": "bun run --watch dist/fighorse.js",
    "build": "shadow-cljs release app",
    "compile": "bun build --compile dist/fighorse.js --outfile dist/fighorse",
    "package:darwin-x64": "bun scripts/package.mjs darwin-x64",
    "package:darwin-arm64": "bun scripts/package.mjs darwin-arm64",
    "package:darwin-universal": "bun scripts/package.mjs darwin-universal",
    "package:bundle": "bun scripts/package.mjs bundle",
    "package:macos": "bun scripts/package.mjs macos",
    "package:linux-x64": "bun scripts/package.mjs linux-x64",
    "package:linux-arm64": "bun scripts/package.mjs linux-arm64",
    "package:linux": "bun scripts/package.mjs linux",
    "package:all": "bun scripts/package.mjs all",
    "package": "bun run package:bundle",
    "install:local": "bun run build && bun run compile && ./dist/fighorse install --default --apply --source ./dist/fighorse",
    "test": "shadow-cljs compile test && bun target/test.js",
    "test:integration": "shadow-cljs compile test && FIGMA_INTEGRATION_TESTS=true bun target/test.js",
    "check": "bun run test && bun run build && bun run compile"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "license": "1PL",
  "devDependencies": {
    "shadow-cljs": "^2.28.23"
  }
}
